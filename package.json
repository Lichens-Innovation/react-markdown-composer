{
  "name": "@lichens-innovation/react-markdown-composer",
  "version": "1.6.2",
  "description": "Reusable React component for composing markdown.",
  "author": "Lichens Innovation",
  "license": "MIT",
  "repository": "https://github.com/Lichens-Innovation/react-markdown-composer",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css",
    "./dist/index.js"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": "26.13.0",
    "bun": ">=1.2.0"
  },
  "packageManager": "bun@1.4.4",
  "scripts": {
    "prepare": "husky && patch-package && bun run habit:install",
    "clean:node": "rimraf node_modules bun.lock",
    "start": "vite dev",
    "generate:version": "tsx scripts/generate-version.ts",
    "typecheck": "tsc --noEmit --project tsconfig.app.json",
    "lint": "habit-hooks",
    "lint:ci": "eslint",
    "lint:fix": "eslint . --fix",
    "lint:package": "npmPkgJsonLint .",
    "lint:unused": "knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "security:check": "npx --yes cve-lite-cli@latest . --fail-on high --ratchet --verbose",
    "habit:hooks": "habit-hooks --branch main",
    "habit:snoozed": "habit-snooze --list",
    "habit:install": "sh scripts/install-habit-hooks.sh",
    "build": "rimraf dist && vite build",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:crap": "vitest run --coverage && bunx crap-score --json crap-report/crap-report.json --html crap-report/html/ ./coverage/coverage-final.json"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/theme-one-dark": "6.1.3",
    "@lichens-innovation/ts-common": "1.29.0",
    "@milkdown/crepe": "7.23.0",
    "@milkdown/kit": "7.23.0",
    "@milkdown/react": "7.23.0",
    "@uiw/react-json-view": "2.0.0-alpha.44",
    "codemirror": "6.0.2",
    "date-fns": "4.4.0",
    "handlebars": "4.7.10"
  },
  "peerDependencies": {
    "antd": ">=6.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@lichens-innovation/eslint-plugin-coding-guide": "2.3.3",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/exec": "6.0.3",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/github": "10.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "4.1.12",
    "antd": "6.7.0",
    "commitlint": "21.2.4",
    "eslint": "10.14.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-testing-library": "7.16.2",
    "eslint-plugin-unicorn": "73.0.0",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "jscpd": "5.4.2",
    "jsdom": "30.1.3",
    "knip": "6.44.1",
    "lint-staged": "17.6.0",
    "npm-package-json-lint": "11.0.1",
    "patch-package": "8.0.1",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rimraf": "6.1.4",
    "semantic-release": "24.2.9",
    "ts-morph": "28.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "unplugin-dts": "1.1.2",
    "vite": "8.3.6",
    "vitest": "4.1.12"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,cjs,mjs}": [
      "prettier --write"
    ],
    "package.json": [
      "npmPkgJsonLint",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
