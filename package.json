{
  "name": "@lichens-innovation/react-markdown-composer",
  "version": "1.4.0",
  "description": "Reusable React component for composing markdown.",
  "author": "Lichens Innovation",
  "license": "MIT",
  "repository": "https://github.com/Lichens-Innovation/react-markdown-composer",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css",
    "./dist/index.js"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": "26.3.0",
    "bun": ">=1.2.0"
  },
  "packageManager": "bun@1.4.0",
  "scripts": {
    "prepare": "husky && patch-package",
    "clean:node": "rimraf node_modules bun.lock",
    "start": "vite dev",
    "generate:version": "tsx scripts/generate-version.ts",
    "typecheck": "tsc --noEmit --project tsconfig.app.json",
    "lint": "habit-hooks",
    "lint:ci": "eslint",
    "lint:fix": "eslint . --fix",
    "lint:package": "npmPkgJsonLint .",
    "lint:unused": "knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "habit:hooks": "habit-hooks --branch main",
    "habit:snoozed": "habit-snooze --list",
    "build": "rimraf dist && vite build",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:crap": "vitest run --coverage && bunx crap-score --json crap-report/crap-report.json --html crap-report/html/ ./coverage/coverage-final.json"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/state": "6.7.1",
    "@codemirror/theme-one-dark": "6.1.3",
    "@lichens-innovation/ts-common": "1.25.0",
    "@milkdown/crepe": "7.22.1",
    "@milkdown/kit": "7.22.1",
    "@milkdown/react": "7.22.1",
    "@uiw/react-json-view": "2.0.0-alpha.43",
    "codemirror": "6.0.2",
    "date-fns": "4.4.0",
    "handlebars": "4.7.9"
  },
  "peerDependencies": {
    "antd": ">=6.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "10.0.1",
    "@lichens-innovation/eslint-plugin-coding-guide": "1.0.3",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/exec": "6.0.3",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/github": "10.0.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/coverage-v8": "4.1.11",
    "antd": "6.6.2",
    "commitlint": "21.2.2",
    "eslint": "10.9.1",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "eslint-plugin-sonarjs": "4.2.0",
    "eslint-plugin-testing-library": "7.16.2",
    "eslint-plugin-unicorn": "73.0.0",
    "globals": "17.11.0",
    "husky": "9.1.7",
    "jscpd": "5.0.16",
    "jsdom": "30.0.1",
    "knip": "6.32.2",
    "lint-staged": "17.3.0",
    "npm-package-json-lint": "11.0.0",
    "patch-package": "8.0.1",
    "prettier": "3.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rimraf": "6.1.3",
    "semantic-release": "24.0.0",
    "ts-morph": "28.0.0",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "unplugin-dts": "1.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,cjs,mjs}": [
      "prettier --write"
    ],
    "package.json": [
      "npmPkgJsonLint",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
